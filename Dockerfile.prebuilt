FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    python3 \
    python3-reportlab \
    fonts-dejavu-core \
    fonts-dejavu-extra \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY target/release/kitsumed /app/kitsumed
COPY locales ./locales
COPY assets ./assets
COPY scripts ./scripts

RUN mkdir -p /opt/kitsumed && ln -s /app/scripts /opt/kitsumed/scripts

ENV RUST_LOG=info

CMD ["/app/kitsumed"]
